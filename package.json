{
  "name": "promptbook-starter",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "npm run test:e2e",
    "test:e2e": "node tests/e2e.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run test:e2e",
    "coder:generate-boilerplates": "npx ptbk coder generate-boilerplates --count 5*1 --template ./prompts/templates/common.md",
    "coder:add": "npx ptbk coder add --template ./prompts/templates/common.md",
    "coder:run": "npx ptbk coder run --harness openai-codex --model gpt-5.6-luna --thinking-level low --agent agents/developer.book --context AGENTS.md --test-before yes-and-fix",
    "coder:verify": "npx ptbk coder verify"
  },
  "dependencies": {
    "next": "latest",
    "ptbk": "^0.114.0-29",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "latest",
    "eslint-config-next": "latest",
    "puppeteer": "^25.10.0",
    "typescript": "latest"
  }
}
